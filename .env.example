# Coco Squad — Variables de Entorno
# Copiar a .env y completar con valores reales

# ===== LOCAL DEVELOPMENT =====
COCO_LOCAL_DEV=1

# ===== API KEYS =====
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
GOOGLE_API_KEY=your_google_key_here

# ===== DATABASE =====
DATABASE_PATH=database/master.db

# ===== SERVER =====
API_HOST=127.0.0.1
API_PORT=8080

# ===== CORS =====
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== SENTRY (opcional) =====
SENTRY_DSN=

# ===== JARVIS (opcional) =====
JARVIS_API_KEY=stub_for_local_dev
